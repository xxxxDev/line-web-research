{
  "name": "line-web-research-electron",
  "version": "2026.11.11",
  "private": true,
  "description": "Electron app of line-web-research: runs your own copy of the LINE Chrome extension as a desktop app named XXNE.",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "prepare-extension": "node ../scripts/prepare-electron-extension.cjs",
    "start": "electron .",
    "package": "electron-packager . XXNE --platform=darwin --arch=arm64 --out=dist --overwrite --ignore=^/dist --ignore=^/vendor --app-bundle-id=com.local.line-electron-prototype --no-asar && codesign --force --deep --sign - \"dist/XXNE-darwin-arm64/XXNE.app\""
  },
  "devDependencies": {
    "electron": "44.4.1",
    "@electron/packager": "20.3.0"
  },
  "productName": "XXNE"
}
